{
  "name": "safewalk-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-phase1.ts",
    "smoke:all": "tsx scripts/smoke-phase234.ts",
    "smoke:ci": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-all-smoke.ps1",
    "demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/demo.ps1",
    "agent:ping": "tsx --env-file-if-exists=.env scripts/agent-ping.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "dependencies": {
    "@cline/sdk": "0.0.92",
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.3",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "cloudflared": "0.7.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
