# Copy this file to server/.env and fill in the values. Never commit server/.env.
# Real values are in the team's private chat.

# --- Server ---
# Port the Fastify server listens on.
PORT=3000
# Public base URL of the server (the cloudflared tunnel URL, e.g. https://xyz.trycloudflare.com).
# Used to build guardian links in alert messages. Changes every time the tunnel restarts.
PUBLIC_BASE_URL=http://localhost:3000

# --- Agent (Cline SDK) ---
# Cline API key. Usage is billed to the team's Cline credits (no Anthropic key needed).
# Get it: sign in at https://app.cline.bot -> Settings -> API Keys -> Create API Key.
# Copy it right away (shown only once). Use the account/organisation that holds the credits.
CLINE_API_KEY=
# Provider id for the Cline SDK agent. "cline" = Cline usage-billing (uses CLINE_API_KEY).
AGENT_PROVIDER=cline
# Model id in provider/model format, with a DOT in the version (the hyphen form gives "model not found").
# Testing: anthropic/claude-haiku-5.5 (cheap). Demo: anthropic/claude-opus-5.5.
# Check a model with: cd server; npm run agent:ping -- anthropic/claude-opus-5.5
AGENT_MODEL=anthropic/claude-haiku-5.5
# Seconds one agent step may take before the app sends a fixed template instead.
AGENT_TIMEOUT_SECONDS=25

# --- Notifications ---
# Which notifier to use: telegram | console (console just prints to the server log).
NOTIFY_PROVIDER=telegram
# Telegram bot token from @BotFather (team private chat).
TELEGRAM_BOT_TOKEN=
# Bot username without @, used to build the t.me/<bot>?start=<code> link for contacts.
TELEGRAM_BOT_USERNAME=

# --- Speech-to-text ---
# Groq API key from console.groq.com (team private chat). Used for Whisper transcription of panic audio.
GROQ_API_KEY=

# --- Google ---
# Google Maps Platform key (Places API + Maps SDK for Android). Team private chat.
# The mobile build also needs it: set it as an EAS env var (see README).
GOOGLE_MAPS_API_KEY=

# --- Safety timings ---
# Seconds without a heartbeat before the dead man's switch fires.
HEARTBEAT_TIMEOUT_SECONDS=45
# Default seconds the escalation agent waits for an acknowledgement before the next contact.
# Users can override this in the app settings.
ESCALATION_WAIT_SECONDS=300

# --- Institute sign-up ---
# Email domain allowed for walking-buddy sign-up (without the @).
INSTITUTE_EMAIL_DOMAIN=iitg.ac.in
